{
  "name": "@konstit/cli",
  "version": "0.0.6",
  "description": "A clap-inspired, type-safe command-line parser for Bun and TypeScript",
  "keywords": [
    "bun",
    "clap",
    "cli",
    "type-safe",
    "command-line",
    "declarative",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "KONSTIT ENGENHARIA E TECNOLOGIA LTDA",
    "email": "opensource@konstit.com.br"
  },
  "contributors": [
    {
      "name": "Diego Alcântara",
      "url": "https://github.com/dgoalcantara",
      "email": "diego.alcantara@konstit.com.br"
    },
    {
      "name": "Marcelo Marchioro",
      "url": "https://github.com/Sprayscelo",
      "email": "marcelo.marchioro@konstit.com.br"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konstit-Engenharia/konstit-cli.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./completion": {
      "types": "./dist/completion.d.ts",
      "import": "./dist/completion.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:artifacts && bun run build:validate",
    "build:artifacts": "bun run build:clean && bun run --parallel build:js build:types",
    "build:clean": "bun ./scripts/clean-dist.ts",
    "build:js": "bun build ./src/index.ts ./src/completion.ts ./src/testing.ts --outdir ./dist --target=bun --format=esm --sourcemap=external --keep-names --splitting --chunk-naming 'chunks/[name]-[hash].[ext]'",
    "build:types": "tsc -p tsconfig.build.json",
    "build:validate": "bun ./scripts/validate-package.ts && bun ./scripts/check-package-consumer.ts",
    "benchmark:types": "bun run build:artifacts && bun ./scripts/benchmark-types.ts",
    "analyze:bundle": "bun ./scripts/analyze-bundle.ts",
    "release": "bun ./scripts/release.ts",
    "test": "bun test --parallel",
    "coverage": "bun test --dots --coverage",
    "typecheck": "bun --no-script check",
    "check": "bun run --parallel typecheck coverage build",
    "format": "bunx --bun dprint fmt",
    "format:check": "bunx --bun dprint check",
    "lint": "bun run --parallel typecheck lint:biome lint:oxlint",
    "lint:biome": "bunx @biomejs/biome check",
    "lint:oxlint": "bunx oxlint --type-aware"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "latest",
    "dprint": "0.65.0",
    "mitata": "1.0.34",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.4.5"
  }
}
